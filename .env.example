# False runs the local CPU-safe simulation without a remote model.
DIFFUSIONGUARD_ENABLE_LLM=false

# Supported providers: groq, openai.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Keep secrets empty in this example file.
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Conservative defaults for the Groq free tier.
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=1
LLM_MAX_CALLS_PER_RUN=30
LLM_REQUEST_INTERVAL_SECONDS=8
LLM_CACHE_ENABLED=true
LLM_CACHE_PATH=.cache/llm_responses.sqlite3
